--- a/eval.sh
+++ b/eval.sh
@@ -19,6 +19,8 @@
 die() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }
 ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
 task= model= setting=both episodes=100 port=9330 output= check=0 health_timeout=600 video=False
+# DVAC: 默认空 → 与冻结行为逐位一致；启用示例：DVAC_ARGS="--dvac_alpha 1.0" ./eval.sh ...
+DVAC_ARGS=${DVAC_ARGS:-}
 while (($#)); do
   case "$1" in
     --help) usage; exit 0 ;;
@@ -48,7 +50,7 @@
 SIM_PY="$ROOT/repos/RLinf/.venv/bin/python"
 export QWEN3VL_PATH=${QWEN3VL_PATH:-$ROOT/models/qwen3vl}
