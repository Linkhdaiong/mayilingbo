+printf 'PLAN task=%s setting=%s episodes=%s port=%s FP32 compile=True chunk=50 num_steps=10 offline=1 dvac=%s\n' "$task" "$setting" "$episodes" "$port" "${DVAC_ARGS:-<off>}"
 failed=0
 for command in python3 nvidia-smi curl flock tee; do
   if ! command -v "$command" >/dev/null; then printf 'BLOCKED: command missing: %s\n' "$command"; failed=1; fi
@@ -181,7 +183,7 @@
   cd "$V2"
   exec "$INFER_PY" -u deploy/lingbot_vla_v2_policy.py \
