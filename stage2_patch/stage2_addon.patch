+def test_dvac_buffer_is_bounded():
+    s = _FakeServer()
+    for _ in range(50):
+        _call(s, _chunk(0.01))
+    assert len(s._dvac_buf) <= s._dvac_buf_maxlen
+    assert len(s._dvac_buf) == s._dvac_buf_maxlen
