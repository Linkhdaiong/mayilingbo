+"""EMA 影子模块（补官方 `lingbotvla/utils/ema.py` 缺失的容器）。
+
+为什么单独一个文件
+------------------
+官方仓库**已经**把 EMA 的存取接线做完了：
+  * ``Checkpointer.save``：``state["ema"]`` 非 None 时写入 ``checkpoints/global_step_N/ema/``；
+  * ``AsyncHFCheckpointSaver``：``save_ema=True`` 时额外导出 ``ema_hf_ckpt/``；
+  * ``ckpt_to_state_dict(..., ema=True)`` 负责读回。
+但 ``tasks/vla/train_lingbotvla.py`` 与 ``train_pi0.py`` 里都只写了 ``"ema": None``，
+从未创建影子模型，所以整条通路是死的。本模块只补“容器 + 更新”这一块，
+**不改官方 ``lingbotvla/utils/ema.py``**（那个 ``ema_update`` 要求目标参数是 fp32，
+6.4B 参数即 25.5 GB 显存，不可用）。
+
+设计
+----
+* 影子参数逐层镜像主模型，**参数名与主模型完全一致**（不额外加前缀），因此官方的
+  DCP 存取与 HF 导出可以直接使用；
+* 影子参数用 bf16 保存（约 12.8 GB），主模型精度不变；
+* ``decay <= 0`` 时不创建对象，训练行为与改动前逐位一致；
+* 合规依据：赛题规则 2.3「训练期 EMA（产出仍为一份权重）」。EMA 不引入任何新的
+  监督信号，也零环境调用。
+
+关于 bf16 影子与随机舍入
+----------------------
+bf16 只有 8 位尾数，相对 ULP ≈ 0.39%、半 ULP ≈ 0.195%；而 ``decay=0.999`` 时单步
+更新量 ≈ ``1e-3·|src| ≈ 0.1%·|dst|`` **小于半 ULP**，直接用
+``dst.mul_(decay).add_(src, alpha=alpha)`` 会让两次舍入都把结果送回原值，影子权重被
+"冻结"在初始化值上且不报错。因此 ``update()`` 改为逐张量用 fp32 中间量计算 +
+随机舍入（stochastic rounding）写回 bf16，详见 :class:`EMAModel` docstring。
+
+用法（train_lingbotvla.py 内）
+-----------------------------
+    ema_model = None
+    if getattr(args.train, "ema_decay", 0.0) > 0:
+        ema_model = EMAModel(model, decay=args.train.ema_decay)
+    ...
+    state = {"model": model, "ema": ema_model, "optimizer": optimizer, "extra_state": {...}}
+    ...
+    optimizer.step()
+    if ema_model is not None:
+        ema_model.update(model)
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Dict, List, Optional
+
+import torch
+import torch.nn as nn
+
+__all__ = ["EMAModel"]
+
+logger = logging.getLogger(__name__)
+
+# 随机舍入 / 距离计算的分块元素数：避免为最大的单张量额外申请整块 fp32 临时量
+# （16M 元素 = 64 MB fp32），峰值额外显存只与分块大小有关，而不是 12.8 GB 级。
+_SR_CHUNK = 1 << 24
+
+
+def _local_view(t: torch.Tensor) -> torch.Tensor:
+    """DTensor → 本地分片张量（与 DTensor 共享存储）；普通张量原样返回。
+
+    FSDP2 下主模型参数是 DTensor，而 bit-view（``view(torch.int32)``）不在 DTensor 的
+    分片传播规则里，因此随机舍入统一在本地视图上做（单卡 1 rank 时本地视图就是全量）。
+    """
+    to_local = getattr(t, "to_local", None)
+    if callable(to_local) and hasattr(t, "device_mesh"):
+        return to_local()
+    return t
+
+
+def _stochastic_round_bf16_(dst: torch.Tensor, val: torch.Tensor, generator: Optional[torch.Generator] = None) -> None:
+    """把 fp32 值 ``val`` 以**随机舍入**写回 bf16 张量 ``dst``（原地）。
+
+    bf16 的位模式就是 fp32 的高 16 位，所以"舍入到 bf16"只取决于低 16 位是否进位：
+    给 fp32 位模式加上 ``U(0, 2^16)`` 的随机整数再截断低 16 位，即"以概率
+    ``low16 / 2^16`` 向上进位"，期望上无偏。低 16 位为 0 的值加随机数后若不跨过
+    2^16 边界则不进位，因此不动点不会被系统性打破；而 0.1% 量级的增量（低 16 位
+    ≈ 256）能以 ≈0.4% 的概率进位，期望增量正好等于原值。符号/量级由位模式本身保证
+    （符号位与阶码位于高 16 位，加法只影响尾数低位与少量进位）。
+
+    NaN/Inf 元素不做舍入，直接保留 ``dst`` 原值（跳过）。
+    """
+    dst = _local_view(dst)
+    val = _local_view(val)
+    if dst.shape != val.shape:
+        raise RuntimeError(
+            "EMA 随机舍入：影子与主模型的本地分片形状不一致（DTensor 布局不同），"
+            "无法安全原地写回；请把 ema_dtype 设为 float32 或关闭 EMA。"
+        )
+    if not dst.is_contiguous():
+        # 影子参数来自 clone，正常一定 contiguous；万一不是，reshape 会拿到副本
+        # 导致写入丢失（等于又一次"静默失效"），这里显式走临时张量
+        tmp = dst.contiguous()
+        _stochastic_round_bf16_(tmp, val, generator)
+        dst.copy_(tmp)
+        return
+    dst_flat = dst.reshape(-1)
+    val_flat = val.reshape(-1)
+    n = val_flat.numel()
+    for start in range(0, n, _SR_CHUNK):
+        end = min(start + _SR_CHUNK, n)
+        chunk = val_flat[start:end].contiguous()
+        # 用 int64 承载位模式，避免极大指数（bits 接近 0x7F7Fxxxx）时 int32 加法溢出
+        bits = chunk.view(torch.int32).to(torch.int64)
+        noise = torch.randint(0, 1 << 16, bits.shape, dtype=torch.int64, device=bits.device, generator=generator)
+        # & -65536 == 丢弃低 16 位，只保留 fp32 的高 16 位（即 bf16）
+        rounded = ((bits + noise) & -65536).to(torch.int32).view(torch.float32).to(torch.bfloat16)
+        finite = torch.isfinite(chunk)
+        dst_flat[start:end].copy_(torch.where(finite, rounded, dst_flat[start:end]))
+
+
+def _rel_l2(a: torch.Tensor, b: torch.Tensor) -> Optional[float]:
+    """``||a - b||_2 / ||b||_2``；分块累加，本地形状不一致时返回 None。"""
+    a_flat = _local_view(a).detach().reshape(-1)
+    b_flat = _local_view(b).detach().reshape(-1)
+    if a_flat.numel() != b_flat.numel():
+        return None
+    num = 0.0
+    den = 0.0
+    n = a_flat.numel()
+    for start in range(0, n, _SR_CHUNK):
+        end = min(start + _SR_CHUNK, n)
+        x = a_flat[start:end].to(torch.float32)
+        y = b_flat[start:end].to(torch.float32)
+        num += float((x - y).pow(2).sum().item())
+        den += float(y.pow(2).sum().item())
+    return (num ** 0.5) / (den ** 0.5 + 1e-12)
+
+
+class EMAModel(nn.Module):
+    """与主模型同构的影子模块（bf16 影子参数）。
+
+    为什么必须随机舍入（stochastic rounding）
+    ----------------------------------------
+    bf16 尾数 8 位 ⇒ 相对 ULP ≈ 0.39%、半 ULP ≈ 0.195%；而 ``decay=0.999`` 时单步
+    增量 = ``(1-decay)·|src| ≈ 0.1%·|dst|`` **小于半 ULP** —— ``0.999·dst`` 舍入回
+    ``dst``、``+0.001·src`` 也舍入回 ``dst``，影子权重永远停在初始化值（整条 EMA
+    轨道变空操作，却不报错）。随机舍入以概率 ``low16/2^16`` 向上进位，使 0.1% 量级
+    的增量在期望上按比例累积，从而既保留 bf16 影子的显存优势又不冻结。
+
+    Args:
+        model: 主模型（可在 FSDP2 / DTensor 之下；单卡时语义等价于本地张量）。
+        decay: 滑动平均系数，推荐 0.999。
+        dtype: 影子参数精度，默认 bfloat16；``torch.float32`` 时跳过随机舍入、精确计算。
+        update_buffers: 浮点 buffer 是否也做 EMA；整型 buffer（如计数器）一律直拷。
+        log_interval: 每多少次 update 打印一次影子与主模型的相对距离（0 表示关闭）。
+    """
+
+    def __init__(
+        self,
+        model: nn.Module,
+        decay: float = 0.999,
+        dtype: torch.dtype = torch.bfloat16,
+        update_buffers: bool = True,
+        log_interval: int = 100,
+    ) -> None:
+        super().__init__()
+        if not (0.0 < decay < 1.0):
+            raise ValueError(f"ema decay 必须在 (0, 1) 区间内，收到 {decay}")
+        self.decay = float(decay)
+        self.ema_dtype = dtype
+        self.update_buffers_flag = bool(update_buffers)
+        self.log_interval = int(log_interval)
+        self.num_updates = 0
+        self._param_names: List[str] = []
+        self._buffer_names: List[str] = []
+
+        # ---------- 用 self 作为根，逐层镜像主模型的模块树 ----------
+        modules: Dict[str, nn.Module] = {"": self}
+        for name, _mod in model.named_modules():
+            if name == "":
+                continue
+            parent, _, leaf = name.rpartition(".")
+            child = nn.Module()
+            setattr(modules[parent], leaf, child)
+            modules[name] = child
+
+        for name, p in model.named_parameters():
+            parent, _, leaf = name.rpartition(".")
+            shadow = p.detach().to(dtype).clone()
+            modules[parent].register_parameter(leaf, nn.Parameter(shadow, requires_grad=False))
+            self._param_names.append(name)
+
+        for name, b in model.named_buffers():
+            parent, _, leaf = name.rpartition(".")
+            holder = modules[parent]
+            if leaf in dict(holder.named_parameters()) or leaf in dict(holder.named_buffers()):
+                continue
+            holder.register_buffer(leaf, b.detach().clone())
+            self._buffer_names.append(name)
+
+    # ------------------------------------------------------------------ #
+    @torch.no_grad()
+    def _ema_update_tensor_(self, dst: torch.Tensor, src: torch.Tensor, decay: float, alpha: float) -> None:
+        """单个张量的 EMA 更新：fp32 中间量计算，再按影子精度写回。"""
+        # new = decay·dst + alpha·src，全部在 fp32 里算（峰值额外显存 ≈ 2× 本张量；
+        # 随机舍入内部再按 64 MB 分块，不会为最大张量整块申请临时量）
+        new = dst.to(torch.float32).mul(decay).add_(src.to(torch.float32), alpha=alpha)
+        if dst.dtype == torch.bfloat16:
+            # bf16 写回必须随机舍入，否则 0.1% 量级的增量会被半 ULP 吞掉
+            _stochastic_round_bf16_(dst, new)
+        elif dst.dtype == torch.float32:
+            # fp32 影子：跳过随机舍入，直接精确写回
+            dst.copy_(new)
+        else:
+            # 其它低精度（本仓库未使用 ema_dtype=fp16 等）：常规就近舍入
+            dst.copy_(new.to(dst.dtype))
+
+    @torch.no_grad()
+    def update(self, model: nn.Module) -> None:
+        """在 ``optimizer.step()`` 之后调用一次。"""
+        decay = self.decay
+        alpha = 1.0 - decay
+        src_params = dict(model.named_parameters())
+        for name, dst in self.named_parameters():
+            src = src_params.get(name)
+            if src is None:
+                continue
+            self._ema_update_tensor_(dst, src.detach(), decay, alpha)
+
+        if self.update_buffers_flag:
+            src_bufs = dict(model.named_buffers())
+            for name, dst in self.named_buffers():
+                src = src_bufs.get(name)
+                if src is None:
+                    continue
+                src = src.detach()
+                if not torch.is_floating_point(dst):
+                    dst.copy_(src.to(dst.device))
+                    continue
+                self._ema_update_tensor_(dst, src, decay, alpha)
+
+        self.num_updates += 1
+        self._maybe_log(model)
+
+    @torch.no_grad()
+    def ema_distance(self, model: nn.Module, max_tensors: int = 8) -> float:
+        """抽样若干张量，返回 ``||ema - model||_2 / ||model||_2`` 的平均值。
+
+        可观测性入口（也供测试调用）：bf16 影子被舍入吞掉时该值恒为 0。
+        抽样按参数名等间距取，避免只看第一层（embedding）而误判整体。
+        """
+        src_params = dict(model.named_parameters())
+        dst_params = dict(self.named_parameters())
+        names = [n for n in self._param_names if n in src_params and n in dst_params]
+        if not names:
+            return 0.0
+        max_tensors = max(1, int(max_tensors))
+        if len(names) > max_tensors:
+            step = len(names) / max_tensors
+            names = [names[int(i * step)] for i in range(max_tensors)]
+        dists: List[float] = []
+        for name in names:
+            d = _rel_l2(dst_params[name], src_params[name])
+            if d is not None:
+                dists.append(d)
+        if not dists:
+            return 0.0
+        return sum(dists) / len(dists)
+
+    @torch.no_grad()
+    def _maybe_log(self, model: nn.Module) -> None:
+        """每 ``log_interval`` 次更新（以及第 1 次更新）打印一次相对距离。"""
+        if self.log_interval <= 0:
+            return
+        if self.num_updates != 1 and self.num_updates % self.log_interval != 0:
+            return
+        dist = self.ema_distance(model)
+        logger.info(
+            "[EMA] update=%d decay=%.4f dtype=%s rel_dist(ema vs model)=%.3e",
+            self.num_updates,
+            self.decay,
+            self.ema_dtype,
+            dist,
+        )
+        if dist == 0.0:
+            logger.warning(
+                "[EMA] 第 %d 次更新后 ||ema-model||/||model|| 仍为 0：EMA 未生效"
+                "（影子权重没跟上主模型，低精度写回可能又被舍入吞掉了）。",
+                self.num_updates,
+            )
+
+    @torch.no_grad()
+    def copy_to(self, model: nn.Module) -> None:
+        """把 EMA 权重写回主模型（仅调试/导出验证用；正式流程走 ``ema_hf_ckpt``）。"""
+        src_params = dict(self.named_parameters())
+        for name, dst in model.named_parameters():
+            src = src_params.get(name)
+            if src is not None:
+                dst.data.copy_(src.data.to(dst.dtype))
+
+    def extra_repr(self) -> str:
+        return (
+            f"decay={self.decay}, dtype={self.ema_dtype}, num_updates={self.num_updates}, "
+            f"params={len(self._param_names)}, buffers={len(self._buffer_names)}"
+        )
--- a/tools/build_motion_weights.py
+++ b/tools/build_motion_weights.py
@@ -0,0 +1,288 @@
+#!/usr/bin/env python3
+"""生成「低运动窗口降权」sidecar。
+
+思路
+----
+50 个任务 × 50 条 clean 轨迹里，有大量"几乎不动"的帧（抓稳之后的等待、任务完成后的
+静止、以及对齐前的微调）。这些帧占掉大量梯度权重，却教不出任何推进动作；实测评测侧
+4,611 个失败 episode **100% 是跑满 400 步超时**（不是早失败），说明模型学到了"待着不动"
+这个安全动作。本脚本按 release 数据**自身**的动作位移统计，给静止窗口降权。
+
+合规
+----
+* 训练全程零环境调用；
+* 权重只由 release 数据集的动作张量自身统计得到（不涉及成功率/奖励/评测结果）；
+* 属于赛题规则 2.1「按数据统计量重加权」；
+* 产出格式与 ``tools/build_adv_weights.py`` 完全一致，因此训练侧复用既有
+  ``--data.adv_weight_path`` 通路，**不需要改数据加载代码**。
+
+权重定义
+--------
+对第 e 条轨迹的动作序列 ``A ∈ R^{T×D}``：
+1. 逐维用全体数据的标准差 ``s_d`` 归一化（避免大量纲维度主导）；
+2. 逐帧位移 ``δ_t = mean_d |A[t+1,d] − A[t,d]| / s_d``（末帧复制前一帧）；
+3. 平滑 ``m_t = mean(δ_t … δ_{t+W−1})``，W = ``--window``（默认 10）；
+4. ``w_t = clamp((m_t / median(m)) ** 0.5, lo, hi)``（默认 lo=0.6, hi=1.0）；
+5. 全库归一化到 ``mean(w) = 1``（与 advantage 权重的归约口径一致，保持损失量级可比）。
+
+输出
+----
+**每个任务一份** sidecar：``<output-dir>/<data_name>.pt``，内容为
+``torch.save({"weights", "config", "episode_lengths", "num_samples"})``。
+逐任务输出是必须的：``VLADataset`` 会校验 sidecar 样本数 == 本任务样本数，
+而多任务训练会把同一份 config 传给每个任务的 dataset。
+``episode_lengths`` 让训练侧用 ``(episode_index, frame_index)`` 定位权重。
+
+用法
+----
+    python tools/build_motion_weights.py \
+        --data-root   /path/datasets/robotwin/lerobot \
+        --manifest    /path/datasets/robotwin/clean_training_data.txt \
+        --output-dir  /path/datasets/robotwin/motion_weights_clean50
+
+    # 训练：--data.adv_weight_path=/path/datasets/robotwin/motion_weights_clean50
+
+``--manifest`` 与训练的 ``data.train_path`` 必须是同一份清单（逐任务顺序一致）；
+脚本会按清单顺序拼接各任务的权重，并在写盘前断言总帧数一致。
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import os
+import sys
+from typing import List, Sequence, Tuple
+
+import numpy as np
+import torch
+
+
+# --------------------------------------------------------------------------- #
+# 读取
+# --------------------------------------------------------------------------- #
+def _read_episode_lengths(root: str) -> Tuple[List[int], dict]:
+    """读每个 episode 的帧数（v2.x episodes.jsonl 与 v3 episodes/*.parquet 都支持）。"""
+    meta_dir = os.path.join(root, "meta")
+    info = {}
+    info_path = os.path.join(meta_dir, "info.json")
+    if os.path.isfile(info_path):
+        with open(info_path, "r", encoding="utf-8") as f:
+            info = json.load(f)
+
+    lengths: List[int] = []
+    episodes_dir = os.path.join(meta_dir, "episodes")
+    if os.path.isdir(episodes_dir):
+        try:
+            import pyarrow.parquet as pq
+
+            files = sorted(glob.glob(os.path.join(episodes_dir, "**", "*.parquet"), recursive=True))
+            rows: List[Tuple[int, int]] = []
+            for fp in files:
+                table = pq.read_table(fp, columns=["episode_index", "length"])
+                rows.extend(zip(table.column("episode_index").to_pylist(),
+                                table.column("length").to_pylist()))
+            rows.sort(key=lambda r: r[0])
+            lengths = [int(r[1]) for r in rows]
+        except Exception:
+            lengths = []
+
+    if not lengths:
+        jsonl = os.path.join(meta_dir, "episodes.jsonl")
+        if os.path.isfile(jsonl):
+            rows = []
+            with open(jsonl, "r", encoding="utf-8") as f:
+                for line in f:
+                    line = line.strip()
+                    if line:
+                        rec = json.loads(line)
+                        rows.append((int(rec["episode_index"]), int(rec["length"])))
+            rows.sort(key=lambda r: r[0])
+            lengths = [r[1] for r in rows]
+
+    if not lengths:
+        raise FileNotFoundError(f"在 {meta_dir} 下找不到 episode 元数据")
+    return lengths, info
+
+
+def _read_actions(root: str, lengths: Sequence[int]) -> np.ndarray:
+    """按 episode 顺序读出动作，返回 (sum(lengths), D) 的 float32 数组。"""
+    import pyarrow.parquet as pq
+
+    files = sorted(glob.glob(os.path.join(root, "data", "**", "*.parquet"), recursive=True))
+    if not files:
+        raise FileNotFoundError(f"在 {root}/data 下找不到 parquet 文件")
+
+    chunks = []
+    for fp in files:
+        table = pq.read_table(fp, columns=["episode_index", "frame_index", "action"])
+        ep = np.asarray(table.column("episode_index").to_pylist(), dtype=np.int64)
+        fr = np.asarray(table.column("frame_index").to_pylist(), dtype=np.int64)
+        act = np.asarray(table.column("action").to_pylist(), dtype=np.float32)
+        if act.ndim == 1:  # 单维动作
+            act = act[:, None]
+        chunks.append((ep, fr, act))
+
+    ep = np.concatenate([c[0] for c in chunks])
+    fr = np.concatenate([c[1] for c in chunks])
+    act = np.concatenate([c[2] for c in chunks], axis=0)
+
+    order = np.lexsort((fr, ep))
+    ep, fr, act = ep[order], fr[order], act[order]
+
+    # 校验：episode 连续、帧号从 0 连续递增、总帧数与 meta 一致
+    n_expected = int(sum(lengths))
+    if act.shape[0] != n_expected:
+        raise ValueError(
+            f"数据帧数 ({act.shape[0]}) 与 episode 长度之和 ({n_expected}) 不一致，"
+            "数据集可能不完整"
+        )
+    for e, ln in enumerate(lengths):
+        mask = ep == e
+        got = int(mask.sum())
+        if got != int(ln):
+            raise ValueError(f"episode {e} 帧数 {got} != meta 声明的 {ln}")
+        if got and (fr[mask].min() != 0 or fr[mask].max() != got - 1):
+            raise ValueError(f"episode {e} 的 frame_index 不是 0..{got-1} 连续")
+    return act
+
+
+# --------------------------------------------------------------------------- #
+# 权重
+# --------------------------------------------------------------------------- #
+def motion_weights(
+    actions: np.ndarray,
+    lengths: Sequence[int],
+    window: int = 10,
+    lo: float = 0.6,
+    hi: float = 1.0,
+    power: float = 0.5,
+    eps: float = 1e-6,
+) -> Tuple[np.ndarray, dict]:
+    a = actions.astype(np.float32, copy=False)
+    scale = a.std(axis=0)
+    scale = np.where(scale < eps, 1.0, scale).astype(np.float32)
+
+    delta = np.zeros(a.shape[0], dtype=np.float32)
+    off = 0
+    for ln in lengths:
+        seg = a[off: off + ln]
+        if ln >= 2:
+            d = np.abs(seg[1:] - seg[:-1]) / scale
+            d = d.mean(axis=1)
+            delta[off: off + ln - 1] = d
+            delta[off + ln - 1] = d[-1]
+        off += ln
+
+    # 窗口平滑（两端用 edge padding，避免尾部被压低）
+    if window > 1:
+        pad = window // 2
+        padded = np.pad(delta, (pad, window - 1 - pad), mode="edge")
+        kernel = np.ones(window, dtype=np.float32) / window
+        motion = np.convolve(padded, kernel, mode="valid")
+    else:
+        motion = delta
+
+    ref = float(np.median(motion)) if motion.size else 1.0
+    ref = max(ref, eps)
+    w = np.power(motion / ref, power)
+    w = np.clip(w, lo, hi).astype(np.float32)
+    mean_pre = float(w.mean())
+    w = w / max(mean_pre, eps)  # 归一化到 mean(w)=1（与 advantage 权重同口径）
+
+    stats = {
+        "kind": "motion_window_downweight",
+        "window": window,
+        "clip": [lo, hi],
+        "power": power,
+        "motion_median": ref,
+        "frac_at_lo": float((w <= (lo / max(mean_pre, eps)) * 1.001).mean()),
+        "mean_pre_norm": mean_pre,
+        "mean_after_norm": float(w.mean()),
+        "num_samples": int(w.size),
+    }
+    return w, stats
+
+
+def _iter_manifest(path: str) -> List[Tuple[str, str]]:
+    out = []
+    with open(path, "r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            parts = line.split()
+            if len(parts) < 2:
+                raise ValueError(f"清单行格式异常（需要 '<data_name> <repo_path>'）：{line!r}")
+            out.append((parts[0], parts[1]))
+    return out
+
+
+def main(argv=None) -> int:
+    p = argparse.ArgumentParser(description="生成低运动窗口降权 sidecar（每任务一份）")
+    p.add_argument("--data-root", required=True,
+                   help="LeRobot 数据集根目录；若 --manifest 里是绝对路径则忽略此项")
+    p.add_argument("--manifest", required=True,
+                   help="与训练 data.train_path 完全一致的清单（只有 data_name 顺序需要一致）")
+    p.add_argument("--output-dir", required=True,
+                   help="输出目录；会为每个任务写 <data_name>.pt（多任务训练必须用目录）")
+    p.add_argument("--window", type=int, default=10)
+    p.add_argument("--lo", type=float, default=0.6)
+    p.add_argument("--hi", type=float, default=1.0)
+    p.add_argument("--power", type=float, default=0.5)
+    p.add_argument("--dry-run", action="store_true", help="只打印统计，不写盘")
+    args = p.parse_args(argv)
+
+    entries = _iter_manifest(args.manifest)
+    print(f"[motion] 清单任务数: {len(entries)}")
+
+    per_task = {}
+    summary = []
+    for i, (name, rel) in enumerate(entries):
+        root = rel if os.path.isabs(rel) else os.path.join(args.data_root, rel)
+        if not os.path.isdir(root):
+            print(f"[motion] 跳过（目录不存在）：{root}", file=sys.stderr)
+            return 2
+        lengths, _info = _read_episode_lengths(root)
+        actions = _read_actions(root, lengths)
+        w, stats = motion_weights(actions, lengths, window=args.window,
+                                  lo=args.lo, hi=args.hi, power=args.power)
+        payload = {
+            "weights": torch.from_numpy(w.astype(np.float32)),
+            "config": {
+                "kind": "motion_window_downweight",
+                "data_name": name,
+                "window": args.window,
+                "clip": [args.lo, args.hi],
+                "power": args.power,
+                "manifest": os.path.abspath(args.manifest),
+                **stats,
+            },
+            "episode_lengths": [int(x) for x in lengths],
+            "num_samples": int(w.size),
+        }
+        per_task[name] = stats
+        out_path = os.path.join(args.output_dir, f"{name}.pt")
+        if not args.dry_run:
+            os.makedirs(args.output_dir, exist_ok=True)
+            torch.save(payload, out_path)
+        summary.append((name, w.size, float(w.mean()), stats["frac_at_lo"]))
+        print(f"  [{i+1:2d}/{len(entries)}] {name:28s} episodes={len(lengths):3d} "
+              f"frames={w.size:6d} 静止占比={stats['frac_at_lo']*100:5.1f}% "
+              f"mean={w.mean():.4f}")
+
+    total = sum(s[1] for s in summary)
+    print(f"[motion] 任务数 {len(summary)}，样本合计 {total}")
+    if args.dry_run:
+        print("[motion] dry-run，未写盘")
+        return 0
+    print(f"[motion] 已写出 {len(summary)} 份 sidecar 到：{args.output_dir}")
+    print("[motion] 训练时传 --data.adv_weight_path=<该目录>（目录形式，按 <data_name>.pt 逐任务匹配）")
+
+    print("[motion] 注意 yaml 里不要写 null（会被解析成字符串 'null' 导致找文件崩溃）")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
--- a/tools/export_hf_from_dcp.py
+++ b/tools/export_hf_from_dcp.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""从 DCP checkpoint 导出 HuggingFace 权重（可选导出 EMA 分支）。
+
+为什么需要它
+------------
+stage-1 的每一次 DCP 保存都会顺带导出 `hf_ckpt/`（25.5 GB，fp32）。stage-2 如果
+每 2000 步保存一次，同时导出 `hf_ckpt` + `ema_hf_ckpt`，磁盘占用会到 600 GB 量级。
+因此 stage-2 默认**只存 DCP**（`--train.save_hf_weights=false`），训练结束后用本脚本
+按需把「某个 step 的普通权重 / EMA 权重」导出成可评测的 hf_ckpt。
+
+它走的是官方同一条通路（`ckpt_to_state_dict` + `save_model_weights`），不引入新的
+权重格式。
+
+用法
+----
+    # 导出第 24000 步的普通权重
+    python tools/export_hf_from_dcp.py \
+        --dcp /out/checkpoints/global_step_24000 \
+        --assets-from /models/lingbot_hf_45000/hf_ckpt \
+        --out /out/hf/step_24000_plain
+
+    # 导出同一步的 EMA 权重
+    python tools/export_hf_from_dcp.py \
+        --dcp /out/checkpoints/global_step_24000 --ema \
+        --assets-from /models/lingbot_hf_45000/hf_ckpt \
+        --out /out/hf/step_24000_ema
+
+`--assets-from` 指向任意一份已有的 hf_ckpt（含 config.json / tokenizer 等），
+本脚本只替换里面的权重分片，其余文件原样拷贝。
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import os
+import shutil
+import sys
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from lingbotvla.checkpoint.format_utils import ckpt_to_state_dict  # noqa: E402
+from lingbotvla.models.module_utils import save_model_weights  # noqa: E402
+
+NON_WEIGHT_PATTERNS = (
+    "*.json",
+    "*.txt",
+    "*.model",
+    "*.py",
+    "*.jinja",
+    "*.tiktoken",
+)
+
+
+def main(argv=None) -> int:
+    p = argparse.ArgumentParser(description="导出 DCP（可选 EMA）为 hf_ckpt")
+    p.add_argument("--dcp", required=True, help="checkpoints/global_step_N 目录")
+    p.add_argument("--out", required=True, help="输出 hf_ckpt 目录（不得已存在）")
+    p.add_argument("--assets-from", required=True, help="已有 hf_ckpt 目录，用于拷贝 config/tokenizer")
+    p.add_argument("--ema", action="store_true", help="导出 ema/ 分支（需训练时开了 EMA）")
+    p.add_argument("--ckpt-manager", default="dcp", choices=["dcp", "bytecheckpoint", "native"])
+    p.add_argument("--dtype", default="float32", choices=["float32", "bfloat16"],
+                   help="导出精度；官方提交用 F32（≈25.5 GB）")
+    p.add_argument("--shard-size", type=int, default=5_000_000_000)
+    args = p.parse_args(argv)
+
+    if os.path.exists(args.out):
+        print(f"输出目录已存在，拒绝覆盖：{args.out}", file=sys.stderr)
+        return 2
+    if args.ema:
+        ema_dir = os.path.join(args.dcp, "ema")
+        if not os.path.isdir(ema_dir):
+            print(f"未找到 EMA 分支：{ema_dir}\n"
+                  f"（训练时未开 --train.ema_decay，或该 step 保存时 EMA 尚未创建）",
+                  file=sys.stderr)
+            return 3
+
+    tmp = args.out + ".tmp"
+    if os.path.exists(tmp):
+        shutil.rmtree(tmp)
+    os.makedirs(tmp, exist_ok=True)
+
+    print(f"[export] DCP={args.dcp} ema={args.ema} dtype={args.dtype}")
+    state_dict = ckpt_to_state_dict(
+        save_checkpoint_path=args.dcp,
+        output_dir=tmp,
+        ckpt_manager=args.ckpt_manager,
+        ema=args.ema,
+    )
+    print(f"[export] 取到 {len(state_dict)} 个张量")
+
+    save_model_weights(
+        tmp,
+        state_dict,
+        save_dtype=getattr(torch, args.dtype),
+        shard_size=args.shard_size,
+    )
+    del state_dict
+
+    # 拷贝 config / tokenizer 等非权重文件
+    n_copied = 0
+    for pattern in NON_WEIGHT_PATTERNS:
+        for src in glob.glob(os.path.join(args.assets_from, pattern)):
+            dst = os.path.join(tmp, os.path.basename(src))
+            if os.path.isfile(src) and not os.path.exists(dst):
+                shutil.copy2(src, dst)
+                n_copied += 1
+    print(f"[export] 拷贝非权重文件 {n_copied} 个")
+
+    os.replace(tmp, args.out)
+    total = sum(os.path.getsize(f) for f in glob.glob(os.path.join(args.out, "*.safetensors")))
+    n_shard = len(glob.glob(os.path.join(args.out, "*.safetensors")))
+    print(f"[export] 完成：{args.out}（{n_shard} 分片，{total/1e9:.2f} GB）")
+    print("[export] 下次启动 deploy 前先跑 verify_hf_ckpt.sh 做静态校验")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
